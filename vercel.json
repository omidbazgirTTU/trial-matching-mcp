{
  "version": 2,
  "builds": [
    {
      "src": "api/mcp.py",
      "use": "@vercel/python"
    }
  ],
  "rewrites": [
    { "source": "/api/mcp", "destination": "/api/mcp.py" },
    { "source": "/api/mcp/(.*)", "destination": "/api/mcp.py/$1" },
    { "source": "/mcp", "destination": "/api/mcp.py" },
    { "source": "/mcp/(.*)", "destination": "/api/mcp.py/$1" }
  ]
}
